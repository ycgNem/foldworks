{
  "name": "foldworks",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A pixel-art incremental factory game: build a production line, fold it into a single tile, and build the next floor out of what you folded.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "shots": "node e2e/shots.mjs",
    "screens": "node e2e/screens.mjs",
    "smoke": "node e2e/smoke.mjs",
    "bot": "node e2e/bot.mjs",
    "perf": "node e2e/perf.mjs",
    "art": "node scripts/art-import.mjs",
    "contact": "node scripts/contact.mjs"
  },
  "dependencies": {
    "jsfxr": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "playwright": "1.48.2",
    "typescript": "7.0.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
