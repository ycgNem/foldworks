{
  "name": "foldworks",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A pixel-art incremental factory game: build a production line, fold it into a single tile, and build the next floor out of what you folded.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "jsfxr": "1.4.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "playwright": "1.48.2",
    "typescript": "7.0.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
